# ==============================================================================
# CloudServe AI Support System - Environment Configuration Template
# Copy this file to .env and configure the appropriate variables.
# Never commit .env with real secrets to version control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# LLM Provider Configuration ("groq" or "openrouter")
LLM_PROVIDER=groq

# Groq Configuration (if LLM_PROVIDER=groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_INCLUDE_REASONING=false
GROQ_TIMEOUT=60.0
GROQ_MAX_RETRIES=2

# OpenRouter Configuration (if LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Embedding & Vector Database (Chroma)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PERSIST_DIRECTORY=./data/runtime/chroma_db
CHROMA_COLLECTION_NAME=cloudserve_kb

# Database Configuration (SQLite via synchronous SQLAlchemy)
DATABASE_URL=sqlite:///./data/runtime/cloudserve.db

# Knowledge Base & Dataset Directories
KB_DIRECTORY=./data/kb
DEV_DATA_DIRECTORY=./data/dev
VAL_DATA_DIRECTORY=./data/val

# Decision Engine Thresholds
CONFIDENCE_THRESHOLD_AUTO_RESPOND=0.85
CONFIDENCE_THRESHOLD_REVIEW=0.60
RETRIEVAL_TOP_K=4
RETRIEVAL_SIMILARITY_THRESHOLD=0.65

# Guardrails & Safety Controls
ENABLE_PROMPT_INJECTION_SHIELD=true
ENABLE_CITATION_VERIFIER=true
MAX_RESPONSE_TOKENS=2048
